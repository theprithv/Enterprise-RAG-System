# ============================================================
# RAG Project — Environment Configuration Template
# INSTRUCTIONS: Copy this file to '.env' and fill in your actual values.
# NEVER commit the real '.env' file to Git!
# ============================================================

# Milvus vector database connection
MILVUS_URI=http://localhost:19530
MILVUS_FALLBACK_DB=./milvus_rag.db
MILVUS_COLLECTION=rag_knowledge

# Document ingestion settings
DOCS_DIR=data/documents
VECTOR_DIM=384

# Embedding model (HuggingFace)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# LLM settings (vLLM)
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=sk-dummy
HF_TOKEN=your_huggingface_token_here
BRAVE_API_KEY=your_brave_api_key_here

# Langfuse Telemetry Keys
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
